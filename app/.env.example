# LLM (LiteLLM proxy) — used by extractor, pipeline labelling, guide phrasing
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen38-27b

# Assistant (J10) — all optional; deterministic behaviour without any of them
CHAT_LLM=0                    # 1 = optional LLM phrasing + low-confidence NLU
CHAT_STATE_SECRET=            # >=16 chars; HMAC secret for signed chat state
CHAT_EVAL=0                   # 1 = in-process eval (skips the rate limit)

# Semantic fallback (embedding-based rescue for lexical nulls)
SEMANTIC_FALLBACK=1           # 0 = v6 behaviour exactly (kill switch)
EVAL_MODE=0                   # 1 = honour ?semantic=0|1|only on /api/search
EMBED_PROVIDER=local_onnx     # recorded in app/lib/semantic_config.json
EMBED_MODEL=Xenova/multilingual-e5-small
EMBED_API_KEY=                # only for hosted providers; never NEXT_PUBLIC_
